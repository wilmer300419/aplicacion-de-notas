# Todas las variables son opcionales: el proyecto arranca sin configurar nada.
PORT=3000
NODE_ENV=development
# Si no se define, se genera una clave aleatoria y se guarda en data/.jwt_secret
JWT_SECRET=
# Ruta del archivo SQLite (en Render/Docker apúntala a un disco o volumen persistente)
DATABASE_PATH=./data/notas.sqlite
# Carga usuarios, cursos y notas de ejemplo si la base está vacía. Pon false en producción real.
SEED_DEMO=true
