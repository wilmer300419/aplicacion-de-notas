<%- include('partials/head') %>
<section class="auth card" aria-labelledby="login-title">
  <h1 id="login-title">Inicia sesión</h1>
  <p class="muted">Consulta tus notas o califica a tus estudiantes.</p>
  <form method="post" action="/login" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="email">Correo electrónico</label>
      <input id="email" name="email" type="email" autocomplete="username" value="<%= email %>" maxlength="120" required autofocus>
    </div>
    <div class="field">
      <label for="password">Contraseña</label>
      <div class="input-group">
        <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required>
        <button class="btn btn-ghost" type="button" data-toggle-password="password" aria-controls="password" hidden>Mostrar</button>
      </div>
    </div>
    <button class="btn btn-primary btn-block" type="submit">Entrar</button>
  </form>
  <% if (showDemo) { %>
    <details class="demo">
      <summary>Cuentas de prueba</summary>
      <p>Contraseña de todas: <code>Demo1234!</code></p>
      <ul>
        <li>Profesora: <code>profesor@demo.edu</code></li>
        <li>Estudiante: <code>estudiante@demo.edu</code></li>
      </ul>
    </details>
  <% } %>
</section>
<%- include('partials/foot') %>
